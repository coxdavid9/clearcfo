# Server-side AI configuration for ClearCFO.
# Never expose OPENAI_API_KEY in NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Supabase authentication.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://theclearcfo.com

# QuickBooks Online OAuth.
# Keep this as sandbox while developing against a QuickBooks test company.
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=https://theclearcfo.com/api/quickbooks/callback

# Generate once with: openssl rand -base64 32
# This key encrypts QuickBooks OAuth tokens at rest.
QUICKBOOKS_TOKEN_ENCRYPTION_KEY=

# Stripe sandbox billing.
# Use Stripe TEST mode keys only during development.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_CORE=price_1UGLX649TQ0MJH7uAOWGXWe9
STRIPE_PRICE_PRO=price_1UGLXO49TQ0MJH7uV6jt4ouL
STRIPE_WEBHOOK_SECRET=
